{
  "name": "spotwarp-zero-eviction-guard",
  "display_name": "SpotWarp Fault-Tolerant PyTorch - Zero-Loss Checkpoint Guard",
  "description": "Fault-tolerant PyTorch 2.1 / CUDA 12.1 container recipe for SaladCloud. Pre-configured for continuous checkpoint delta-sync and automated Same-Cloud (Salad -> Salad) node reallocation recovery.",
  "container": {
    "image": "ghcr.io/enplabs/spotwarp:pytorch2.1",
    "resources": {
      "cpu": 4,
      "memory": 16384,
      "gpu_classes": [
        "43a49c0c-f860-40e9-a509-702d0dba0902",
        "a5db5c50-cbcb-4596-ae80-6a0c8090d80f",
        "0d062939-7c01-4aae-a2b1-30e315124e51",
        "ed563892-aacd-40f5-80b7-90c9be6c759b"
      ],
      "storage_amount": 53687091200
    },
    "environment_variables": {
      "LICENSE_KEY": "SALAD-TRIAL",
      "GPU_ACTION_SERVER_URL": "https://gpu-action.com"
    },
    "priority": "high"
  },
  "autostart_policy": true,
  "restart_policy": "always",
  "replicas": 2,
  "networking": {
    "protocol": "http",
    "port": 8888,
    "auth": true
  },
  "readiness_probe": {
    "http": {
      "path": "/tree",
      "port": 8888,
      "scheme": "http",
      "headers": []
    },
    "initial_delay_seconds": 20,
    "period_seconds": 10,
    "timeout_seconds": 5,
    "success_threshold": 1,
    "failure_threshold": 3
  }
}
